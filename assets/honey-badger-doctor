#!/bin/bash
# shellcheck disable=SC2088  # Tilde strings are human-readable labels, not paths
# Ratel Forge Doctor — diagnose a Ratel Forge installation
set -uo pipefail

HB_SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/honey-badger"
# shellcheck source=/dev/null
[[ -r "$HB_SHARE/install-info" ]] && source "$HB_SHARE/install-info"

if [[ -r "$HB_SHARE/ui.sh" ]]; then
    # shellcheck source=/dev/null
    source "$HB_SHARE/ui.sh"
else
    HB_ACCENT='' HB_OK='' HB_WARN='' HB_ERR='' HB_MUTED='' HB_BOLD='' HB_NC=''
    hb_rule() { printf '  %s\n' '──────────────────────────────────────────────────────'; }
    hb_header() { printf '\n  RATEL FORGE  ·  %s\n' "$1"; hb_rule; }
    hb_kv() { printf '  %-22s %s\n' "$1" "$2"; }
    hb_ok() { printf '  ✔ %s\n' "$1"; }
    hb_warn() { printf '  ▲ %s\n' "$1"; }
    hb_err() { printf '  ✖ %s\n' "$1" >&2; }
    hb_info() { printf '  • %s\n' "$1"; }
fi

JSON=0
case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: honey-badger-doctor [--json]

Checks installation metadata, utilities, toolchains, shell setup, SSH
permissions, locale, and common runtime pitfalls.

Exits 0 when no blocking problem is found, 1 otherwise.

Options:
  --json      Machine-readable report
  -h, --help  Show this help message
EOF
        exit 0
        ;;
    --json)
        JSON=1
        ;;
    "")
        ;;
    *)
        printf 'honey-badger-doctor: unknown option: %s\n' "$1" >&2
        printf 'Try honey-badger-doctor --help\n' >&2
        exit 2
        ;;
esac

failures=0
warnings=0

_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
_json=""
_record() {
    [[ -n "$_json" ]] && _json+=$',\n'
    _json+="    {\"status\": \"$1\", \"message\": \"$(_esc "$2")\"}"
}

ok()   { [[ "$JSON" == "1" ]] || hb_ok "$1";   _record ok "$1"; }
warn() { [[ "$JSON" == "1" ]] || hb_warn "$1"; _record warn "$1"; warnings=$((warnings + 1)); }
fail() { [[ "$JSON" == "1" ]] || hb_err "$1";  _record fail "$1"; failures=$((failures + 1)); }
skip() { [[ "$JSON" == "1" ]] || hb_info "$1"; _record skipped "$1"; }

install_type="${HONEY_BADGER_INSTALL_TYPE:-unknown}"
components="${HONEY_BADGER_COMPONENTS:-unknown}"

check_metadata() {
    if [[ -r "$HB_SHARE/install-info" ]]; then
        ok "Install metadata present (${install_type})"
    else
        fail "Install metadata missing ($HB_SHARE/install-info)"
    fi
}

# The apps and minimal profiles intentionally ship no language toolchains.
check_toolchain() {
    if [[ ",$components," != *",dev,"* ]]; then
        skip "Dev component not installed: toolchain checks skipped"
        return 0
    fi

    local tool found=0
    for tool in python3 node go rustc java; do
        if command -v "$tool" >/dev/null 2>&1; then
            ok "Toolchain available: $tool"
            found=$((found + 1))
        fi
    done
    if [[ $found -eq 0 ]]; then
        warn "No language toolchain found on PATH (expected for a developer profile)"
    fi

    if command -v code >/dev/null 2>&1; then
        ok "Editor available: code"
    fi
}

check_path() {
    local entries dupes
    entries=$(printf '%s\n' "${PATH//:/$'\n'}" | sed '/^$/d')
    dupes=$(printf '%s\n' "$entries" | sort | uniq -d)
    if [[ -n "$dupes" ]]; then
        warn "Duplicate PATH entries: $(printf '%s' "$dupes" | tr '\n' ' ')"
    else
        ok "PATH has no duplicate entries"
    fi
}

check_shell_config() {
    local shell_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ratel/shell"
    if [[ ! -d "$shell_dir" ]]; then
        skip "Shell fragments not installed (installer ran with --skip-shell?)"
        return 0
    fi
    if grep -q 'ratel/shell' "$HOME/.bashrc" 2>/dev/null; then
        ok "Shell fragments are installed and sourced"
    else
        warn "Shell fragments exist but ~/.bashrc does not source them"
    fi
}

check_editor_env() {
    local editor="${EDITOR:-}"
    if [[ -z "$editor" ]]; then
        warn "EDITOR is not set"
    elif command -v "${editor%% *}" >/dev/null 2>&1; then
        ok "EDITOR is set to $editor"
    else
        warn "EDITOR points to a missing command: $editor"
    fi
}

check_ssh_permissions() {
    if [[ ! -d "$HOME/.ssh" ]]; then
        skip "No ~/.ssh directory"
        return 0
    fi
    local mode
    mode=$(stat -c '%a' "$HOME/.ssh" 2>/dev/null || true)
    if [[ -z "$mode" ]]; then
        skip "Cannot determine ~/.ssh permissions"
        return 0
    fi
    if [[ "$mode" == "700" ]]; then
        ok "~/.ssh permissions are 700"
    else
        warn "~/.ssh permissions are $mode (expected 700)"
    fi
    local key
    for key in "$HOME"/.ssh/id_*; do
        [[ -f "$key" ]] || continue
        [[ "$key" == *.pub ]] && continue
        mode=$(stat -c '%a' "$key" 2>/dev/null || true)
        [[ -n "$mode" ]] || continue
        if [[ "$mode" != "600" && "$mode" != "400" ]]; then
            warn "Private key permissions are $mode (expected 600): ${key##*/}"
        fi
    done
}

check_locale() {
    local loc="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
    if [[ -z "$loc" ]]; then
        warn "No locale configured"
    elif [[ "$loc" == *UTF-8* || "$loc" == *utf8* ]]; then
        ok "UTF-8 locale: $loc"
    else
        warn "Locale may not be UTF-8: $loc"
    fi
}

check_inotify() {
    local file=/proc/sys/fs/inotify/max_user_watches value
    if [[ ! -r "$file" ]]; then
        skip "inotify limits unavailable"
        return 0
    fi
    value=$(cat "$file" 2>/dev/null || true)
    if [[ ! "$value" =~ ^[0-9]+$ ]]; then
        skip "inotify limit not readable"
        return 0
    fi
    if (( value < 8192 )); then
        warn "inotify watch limit is low ($value); large projects may hit it"
    else
        ok "inotify watch limit: $value"
    fi
}

check_npm_prefix() {
    if ! command -v npm >/dev/null 2>&1; then
        skip "npm not installed"
        return 0
    fi
    local prefix
    prefix=$(npm config get prefix 2>/dev/null || true)
    if [[ -z "$prefix" ]]; then
        skip "npm prefix not reported"
    elif [[ "$prefix" == "$HOME/.npm-global" ]]; then
        ok "npm global prefix is ~/.npm-global"
    else
        warn "npm global prefix is $prefix (Ratel uses ~/.npm-global)"
    fi
}

check_utilities() {
    local -a expected=(info update install doctor uninstall)
    local -a missing=()
    local name
    for name in "${expected[@]}"; do
        command -v "honey-badger-$name" >/dev/null 2>&1 || missing+=("honey-badger-$name")
    done
    if [[ ${#missing[@]} -eq 0 ]]; then
        ok "All ${#expected[@]} utility commands are on PATH"
    else
        fail "Missing utility command(s): ${missing[*]}"
        [[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && \
            warn "~/.local/bin is not on PATH (add: export PATH=\"\$HOME/.local/bin:\$PATH\")"
    fi

    if [[ ":$PATH:" == *":$HOME/.local/bin:"* ]]; then
        ok "~/.local/bin is on PATH"
    else
        warn "~/.local/bin is not on PATH"
    fi
}

check_runtime() {
    if command -v git >/dev/null 2>&1; then
        if [[ -n "$(git config --global user.email 2>/dev/null)" ]]; then
            ok "Git identity configured"
        else
            warn "Git identity is not configured"
        fi
    fi

    if command -v docker >/dev/null 2>&1; then
        if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
            ok "Docker installed and user is in the docker group"
        else
            warn "Docker installed but user is not in the docker group"
        fi
        if [[ -S /var/run/docker.sock ]]; then
            ok "Docker socket present"
        else
            skip "Docker socket not present (daemon may be stopped)"
        fi
    fi

    if [[ -w "$HB_SHARE" ]]; then
        ok "Data directory is writable"
    else
        warn "Data directory is not writable ($HB_SHARE)"
    fi

    local pm found=0
    for pm in pacman apt-get dnf zypper xbps-install slackpkg emerge; do
        if command -v "$pm" >/dev/null 2>&1; then
            ok "Package manager: $pm"
            found=1
            break
        fi
    done
    [[ $found -eq 1 ]] || fail "No supported package manager found"

    if [[ -f /run/reboot-required || -f /var/run/reboot-required ]]; then
        warn "A reboot is required to finish applying updates"
    fi
}

if [[ "$JSON" != "1" ]]; then
    hb_header "Diagnostics"
    hb_kv "Install type" "${install_type} (${HONEY_BADGER_COMPONENTS:-unknown})"
fi
check_metadata
check_toolchain
check_utilities
check_path
check_shell_config
check_editor_env
check_ssh_permissions
check_locale
check_inotify
check_npm_prefix
check_runtime

if [[ "$JSON" == "1" ]]; then
    printf '{\n  "install_type": "%s",\n  "failures": %s,\n  "warnings": %s,\n  "checks": [\n%s\n  ]\n}\n' \
        "$(_esc "$install_type")" "$failures" "$warnings" "$_json"
else
    hb_rule
    printf '  %s failure(s), %s warning(s)\n' "$failures" "$warnings"
fi

if [[ $failures -gt 0 ]]; then
    [[ "$JSON" == "1" ]] || hb_err "Doctor found problems that need attention"
    exit 1
fi
[[ "$JSON" == "1" ]] || hb_ok "No blocking problems found"
exit 0
