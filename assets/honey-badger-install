#!/bin/bash
# Ratel Forge — install, search, or remove packages
set -uo pipefail

HB_SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/honey-badger"
# shellcheck source=/dev/null
[[ -r "$HB_SHARE/ui.sh" ]] && source "$HB_SHARE/ui.sh"

# Fallback UI helpers keep the command usable if the data directory is gone.
if ! declare -f hb_header >/dev/null 2>&1; then
    HB_ACCENT='' HB_OK='' HB_WARN='' HB_ERR='' HB_MUTED='' HB_BOLD='' HB_NC=''
    hb_rule() { printf '  %s\n' '──────────────────────────────────────────────────────'; }
    hb_header() { printf '\n  RATEL FORGE  ·  %s\n' "$1"; hb_rule; }
    hb_kv() { printf '  %-22s %s\n' "$1" "$2"; }
    hb_ok() { printf '  ✔ %s\n' "$1"; }
    hb_warn() { printf '  ▲ %s\n' "$1"; }
    hb_err() { printf '  ✖ %s\n' "$1" >&2; }
    hb_info() { printf '  • %s\n' "$1"; }
fi
# shellcheck source=/dev/null
[[ -r "$HB_SHARE/pm.conf" ]] && source "$HB_SHARE/pm.conf"

: "${HB_PM_INSTALL:=}"
: "${HB_PM_REMOVE:=}"
: "${HB_PM_SEARCH:=}"

usage() {
    cat <<'EOF'
Usage: honey-badger-install [options] <package> [package...]
       honey-badger-install --search <term>
       honey-badger-install --remove <package> [package...]
       honey-badger-install --file <list>

Installs, searches for, or removes packages with the native package manager.

Options:
  -s, --search <term>    Search the repositories
  -r, --remove           Remove the named packages
  -f, --file <path>      Read packages from a file (one per line, # comments)
  -n, --dry-run          Show the command without running it
  -h, --help             Show this help message

Examples:
  honey-badger-install firefox vlc
  honey-badger-install --search image editor
  honey-badger-install --remove thunderbird
  honey-badger-install --file ~/dev-tools.txt
EOF
}

ACTION=install
DRY_RUN=0
SEARCH_TERM=""
FILE=""
PACKAGES=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -r|--remove) ACTION=remove; shift ;;
        -n|--dry-run) DRY_RUN=1; shift ;;
        -s|--search) ACTION=search; shift ;;
        -f|--file)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                printf 'honey-badger-install: --file requires a path\n' >&2
                exit 2
            fi
            FILE="$2"
            shift 2
            ;;
        -*)
            printf 'honey-badger-install: unknown option: %s\n' "$1" >&2
            printf 'Try honey-badger-install --help\n' >&2
            exit 2
            ;;
        *) PACKAGES+=("$1"); shift ;;
    esac
done

if [[ -n "$FILE" && "$ACTION" == "search" ]]; then
    printf 'honey-badger-install: --file cannot be combined with --search\n' >&2
    exit 2
fi

# Package list format: one entry per line; '#' starts a comment; CR and
# surrounding whitespace are ignored.
if [[ -n "$FILE" ]]; then
    if [[ ! -r "$FILE" ]]; then
        printf 'honey-badger-install: cannot read package list: %s\n' "$FILE" >&2
        exit 1
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line//$'\r'/}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" ]] || continue
        PACKAGES+=("$line")
    done < "$FILE"
    if [[ ${#PACKAGES[@]} -gt 0 ]]; then
        mapfile -t PACKAGES < <(printf '%s\n' "${PACKAGES[@]}" | awk '!seen[$0]++')
    fi
fi

if [[ "$ACTION" == "search" ]]; then
    # Any remaining words form the search term, so options may come first.
    if [[ ${#PACKAGES[@]} -eq 0 ]]; then
        printf 'honey-badger-install: --search requires a term\n' >&2
        exit 2
    fi
    SEARCH_TERM="${PACKAGES[*]}"
    if [[ -z "$HB_PM_SEARCH" ]]; then
        hb_err "Search is not configured for this system"
        exit 1
    fi
    hb_header "Search packages"
    hb_info "Searching for: $SEARCH_TERM"
    if [[ $DRY_RUN -eq 1 ]]; then
        hb_info "[DRY-RUN] $HB_PM_SEARCH \"$SEARCH_TERM\""
        exit 0
    fi
    bash -c "$HB_PM_SEARCH \"\$1\"" _ "$SEARCH_TERM" || true
    hb_rule
    exit 0
fi

if [[ ${#PACKAGES[@]} -eq 0 ]]; then
    usage >&2
    exit 1
fi

for arg in "${PACKAGES[@]}"; do
    if [[ ! "$arg" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+:/@-]*$ ]]; then
        hb_err "Invalid package name: $arg"
        printf '  Package names may contain letters, digits, dots, hyphens, underscores, plus signs, colons, slashes, and @.\n' >&2
        exit 1
    fi
done

if [[ "$ACTION" == "remove" ]]; then
    cmd="${HB_PM_REMOVE:-}"
    [[ -n "$cmd" ]] || { hb_err "Package removal is not configured for this system"; exit 1; }
    hb_header "Remove packages"
    progress="Removing"
    finished="Packages removed"
else
    cmd="${HB_PM_INSTALL:-}"
    [[ -n "$cmd" ]] || { hb_err "Package installation is not configured for this system"; exit 1; }
    hb_header "Install packages"
    progress="Installing"
    finished="Packages installed"
fi

if [[ $DRY_RUN -eq 1 ]]; then
    hb_info "[DRY-RUN] $cmd ${PACKAGES[*]}"
    hb_rule
    hb_ok "Nothing to do (dry run)"
    exit 0
fi

hb_info "$progress: ${PACKAGES[*]}"
if bash -c "$cmd \"\$@\"" _ "${PACKAGES[@]}"; then
    hb_rule
    hb_ok "$finished"
else
    hb_err "Package ${ACTION} failed"
    exit 1
fi
