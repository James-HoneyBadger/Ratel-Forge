#!/bin/bash
# Ratel Forge — System Update (fallback copy; install.sh generates a distro-aware one)
set -euo pipefail

if [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then
    ACCENT='' OK='' ERR='' MUTED='' BOLD='' NC=''
else
    ACCENT='\033[38;5;214m'; OK='\033[38;5;113m'; ERR='\033[38;5;203m'
    MUTED='\033[38;5;245m'; BOLD='\033[1m'; NC='\033[0m'
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    printf 'Usage: honey-badger-update\n\n'
    printf 'Updates system packages (and Flatpak/Snap when present),\n'
    printf 'then cleans the package cache.\n'
    exit 0
fi

printf '\n  %s%sRATEL FORGE%s  %s·%s  %sSystem update%s\n\n' \
    "$ACCENT" "$BOLD" "$NC" "$MUTED" "$NC" "$BOLD" "$NC"

run() { printf '  %s•%s %s\n' "$ACCENT" "$NC" "$1"; }

if command -v pacman >/dev/null 2>&1; then
    run "Updating with pacman"
    sudo pacman -Syu --noconfirm
elif command -v apt-get >/dev/null 2>&1; then
    run "Updating with apt"
    sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get autoremove -y
elif command -v dnf >/dev/null 2>&1; then
    run "Updating with dnf"
    sudo dnf update -y && sudo dnf autoremove -y
elif command -v zypper >/dev/null 2>&1; then
    run "Updating with zypper"
    sudo zypper --non-interactive update
elif command -v xbps-install >/dev/null 2>&1; then
    run "Updating with xbps"
    sudo xbps-install -Syu
elif command -v slackpkg >/dev/null 2>&1; then
    run "Updating with slackpkg"
    sudo slackpkg update && sudo slackpkg upgrade-all
elif command -v emerge >/dev/null 2>&1; then
    run "Updating with emerge"
    sudo emerge --sync && sudo emerge -uDN @world
else
    printf '  %s✖%s No supported package manager found\n' "$ERR" "$NC" >&2
    exit 1
fi

if command -v flatpak >/dev/null 2>&1; then
    run "Updating Flatpak packages"
    sudo flatpak update -y || true
fi

if command -v snap >/dev/null 2>&1; then
    run "Refreshing Snap packages"
    sudo snap refresh || true
fi

printf '\n  %s✔%s System update complete\n\n' "$OK" "$NC"
