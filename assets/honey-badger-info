#!/bin/bash
# Ratel Forge — System Information (fallback copy; install.sh generates a richer one)
set -uo pipefail

if [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then
    ACCENT='' OK='' MUTED='' BOLD='' NC=''
else
    ACCENT='\033[38;5;214m'; OK='\033[38;5;113m'
    MUTED='\033[38;5;245m'; BOLD='\033[1m'; NC='\033[0m'
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    printf 'Usage: honey-badger-info\n\n'
    printf 'Shows operating system, hardware, and Ratel details.\n'
    exit 0
fi

os_name="Unknown"
[[ -r /etc/os-release ]] && os_name="$(. /etc/os-release; printf '%s' "${PRETTY_NAME:-Unknown}")"
cpu="$(awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null || true)"
memory="$(free -h 2>/dev/null | awk '/^Mem:/ {print $3 " / " $2}' || true)"
disk="$(df -h / 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " (" $5 " used)"}' || true)"

kv() { printf '  %s%-20s%s %s\n' "$MUTED" "$1" "$NC" "$2"; }

printf '\n  %s%sRATEL FORGE%s  %s·%s  %sSystem information%s\n' \
    "$ACCENT" "$BOLD" "$NC" "$MUTED" "$NC" "$BOLD" "$NC"
printf '  %s──────────────────────────────────────────────────────%s\n' "$MUTED" "$NC"
kv "Operating system" "$os_name"
kv "Kernel"           "$(uname -r)"
kv "Architecture"     "$(uname -m)"
kv "Hostname"         "$(hostname 2>/dev/null || echo unknown)"
kv "User"             "$(whoami)"
kv "Shell"            "${SHELL##*/}"
kv "Desktop"          "${XDG_CURRENT_DESKTOP:-none}"
kv "Uptime"           "$(uptime -p 2>/dev/null || true)"
kv "Memory"           "${memory:-N/A}"
kv "Disk (/)"         "${disk:-N/A}"
[[ -n "$cpu" ]] && kv "Processor" "$(printf '%s' "$cpu" | sed 's/  */ /g')"
printf '  %s──────────────────────────────────────────────────────%s\n' "$MUTED" "$NC"
printf '  %s✔%s Ratel Forge — fearless Linux provisioning\n\n' "$OK" "$NC"
